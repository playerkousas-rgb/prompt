<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PokeGen Switch V5.0 - 遊戲介面生成器</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <style>
    body { font-family: 'Noto Sans TC', system-ui, sans-serif; }
    .tab { transition: all 0.2s ease; border-bottom: 3px solid transparent; }
    .tab-active { color: #fbbf24; border-bottom-color: #fbbf24; font-weight: 700; }
    .input-focus:focus { border-color: #fbbf24; box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.2); outline: none; }
    pre { white-space: pre-wrap; word-break: break-all; font-size: 0.875rem; line-height: 1.6; }
    .bg-switch { background: linear-gradient(135deg, #1f2937 0%, #111827 100%); }
  </style>
</head>
<body class="bg-[#0F172A] text-slate-100 min-h-screen p-4 md:p-8">
  <div class="max-w-7xl mx-auto">
    <header class="bg-slate-900 border-b border-slate-700 px-8 py-6 flex items-center justify-between rounded-3xl mb-8 shadow-2xl">
      <div class="flex items-center gap-4">
        <div class="bg-gradient-to-br from-red-500 to-red-700 p-3 rounded-2xl shadow-lg shadow-red-500/20">
          <i class="fa-solid fa-gamepad text-white text-3xl"></i>
        </div>
        <div>
          <h1 class="text-3xl font-black tracking-tight">PokeGen <span class="text-red-500">V5.0</span></h1>
          <p class="text-xs text-slate-400 tracking-widest font-medium uppercase">Switch UI Pokedex Framework</p>
        </div>
      </div>
      <div class="hidden md:block text-right text-slate-500 text-xs font-mono">
        SYSTEM READY // STABLE_BUILD_2026
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-6 bg-slate-900 rounded-3xl border border-slate-700 overflow-hidden flex flex-col shadow-2xl">
        <div class="flex bg-slate-800 p-2 border-b border-slate-700 overflow-x-auto">
          <button onclick="switchTab(1)" id="tab1" class="tab tab-active flex-1 py-4 text-sm min-w-[100px]">基礎資料</button>
          <button onclick="switchTab(2)" id="tab2" class="tab flex-1 py-4 text-sm min-w-[100px]">圖鑑描述</button>
          <button onclick="switchTab(3)" id="tab3" class="tab flex-1 py-4 text-sm min-w-[100px]">硬體外觀</button>
          <button onclick="switchTab(4)" id="tab4" class="tab flex-1 py-4 text-sm min-w-[100px]">進階指令</button>
        </div>

        <div id="tabContent" class="flex-1 p-8 overflow-auto min-h-[500px]">
          <div id="content1" class="space-y-6">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">角色名稱 (中)</label>
                <input id="pokeName" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="例如：哥吉拉">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">角色名稱 (英)</label>
                <input id="pokeNameEn" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="Godzilla">
              </div>
            </div>
            <div class="grid grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">等級</label>
                <input id="lv" type="number" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" value="60">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">屬性</label>
                <input id="type" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="龍/火">
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase mb-2">圖鑑編號</label>
                <input id="pokeNum" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="#999">
              </div>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">主體視覺描述</label>
              <textarea id="mainVisual" rows="3" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl resize-none" placeholder="描述畫面中央的角色動作與背景，例如：哥吉拉在燃燒的城市中發出藍色射線..."></textarea>
            </div>
          </div>

          <div id="content2" class="hidden space-y-4">
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">分類 (例如：破壞神寶可夢)</label>
              <input id="category" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="破壞神寶可夢">
            </div>
            <div class="grid grid-cols-2 gap-4">
              <input id="height" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="身高: 118.0m">
              <input id="weight" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="體重: 99000t">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">絕招 (用括號分隔)</label>
              <input id="skills" type="text" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl" placeholder="[放射熱線][原子噴射][鋼鐵尾鞭]">
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">詳細說明文本</label>
              <textarea id="description" rows="4" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl resize-none" placeholder="輸入圖鑑的文字介紹..."></textarea>
            </div>
          </div>

          <div id="content3" class="hidden space-y-6">
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">Switch 主機款式</label>
              <select id="consoleStyle" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl">
                <option value="OLED White">OLED 經典白 (White Joy-Con)</option>
                <option value="Neon Red/Blue">電光紅藍 (Neon Red/Blue)</option>
                <option value="Deep Black">全機極客黑 (All Black)</option>
                <option value="Custom Theme">配合角色主題色 (Custom Color)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">UI 風格</label>
              <select id="uiStyle" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl">
                <option value="Pixel Art">懷舊像素風 (Retro Pixel Art)</option>
                <option value="Modern HD">現代高清風 (Modern HD Illustration)</option>
              </select>
            </div>
          </div>

          <div id="content4" class="hidden space-y-6">
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">構圖與圖層修正 (針對手把問題)</label>
              <select id="layerFix" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl">
                <option value="strict">嚴格分層：確保 UI 不會遮擋手把 (Strict Layering)</option>
                <option value="immersive">沉浸式：UI 與手把融合 (Immersive)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-2">額外細節要求</label>
              <textarea id="extra" rows="5" class="input-focus w-full p-4 bg-slate-800 border border-slate-700 rounded-2xl resize-none" placeholder="例如：增加閃電特效、背景要有雨水質感、文字要使用繁體中文..."></textarea>
            </div>
          </div>
        </div>

        <div class="p-8 border-t border-slate-700 grid grid-cols-3 gap-4 bg-slate-900/50">
          <button onclick="generatePokePrompt()" class="bg-gradient-to-r from-red-500 to-orange-600 hover:brightness-110 py-5 rounded-2xl font-bold transition active:scale-95 shadow-lg shadow-red-500/20">🚀 生成</button>
          <button onclick="copyPrompt()" class="bg-slate-700 hover:bg-slate-600 py-5 rounded-2xl font-bold transition active:scale-95">📋 複製</button>
          <button onclick="clearAll()" class="bg-slate-800 hover:bg-red-900/20 py-5 rounded-2xl font-bold border border-slate-700 transition">🗑️ 清除</button>
        </div>
      </div>

      <div class="lg:col-span-6 bg-slate-900 rounded-3xl border border-slate-700 p-8 shadow-2xl flex flex-col">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold flex items-center gap-2 text-red-500"><i class="fas fa-terminal"></i> 最終生成指令</h2>
          <div class="px-3 py-1 bg-red-500/10 border border-red-500/30 rounded-full text-[10px] text-red-500 font-bold tracking-widest">READY FOR AI</div>
        </div>
        <div class="flex-1 bg-slate-950 rounded-2xl p-6 border border-slate-800 overflow-auto">
          <pre id="output" class="text-slate-300 leading-relaxed italic">請填寫左側資料，打造你的專屬圖鑑介面...</pre>
        </div>
      </div>
    </div>
  </div>

<script>
function switchTab(n) {
  document.querySelectorAll('.tab').forEach(b => b.classList.remove('tab-active'));
  document.getElementById('tab' + n).classList.add('tab-active');
  document.querySelectorAll('#tabContent > div').forEach(d => d.classList.add('hidden'));
  document.getElementById('content' + n).classList.remove('hidden');
}

function generatePokePrompt() {
  const getVal = (id) => document.getElementById(id).value.trim();
  
  const data = {
    name: getVal('pokeName') || "未知生物",
    nameEn: getVal('pokeNameEn') || "Unknown",
    lv: getVal('lv'),
    type: getVal('type') || "???",
    num: getVal('pokeNum') || "#000",
    visual: getVal('mainVisual'),
    category: getVal('category'),
    hw: getVal('height') + " / " + getVal('weight'),
    skills: getVal('skills'),
    desc: getVal('description'),
    console: getVal('consoleStyle'),
    ui: getVal('uiStyle'),
    extra: getVal('extra'),
    fix: getVal('layerFix')
  };

  const layerPrompt = data.fix === 'strict' 
    ? "Ensure the Nintendo Switch Joy-Cons are physical objects on the sides, and the UI is strictly contained within the black screen area. The UI elements MUST NOT overlap the hardware buttons or controllers."
    : "";

  const prompt = `A highly detailed product photography of a Nintendo Switch console (OLED ${data.console} style) held in hands or on a table. 
The screen displays a professional Pokemon Pokedex UI for "${data.name} [${data.nameEn}]".

[Screen Content Layout]:
- Top Header: Character Name "${data.name}", Level "Lv.${data.lv}", Type "[${data.type}]", HP Bar (Green), Pokedex Number "${data.num}".
- Center Area: A stunning ${data.ui} illustration of ${data.visual}.
- Bottom Info: Category: "${data.category}", ${data.hw}. 
- Move Set List: ${data.skills}.
- Description: "${data.desc}".
- Navigation Buttons at the bottom: [Detailed Info] [Habitat] [Evolution] [Back].

[Visual Style]:
- The UI must use Traditional Chinese (繁體中文) for all text labels.
- The illustration style in the center window is ${data.ui}.
- Overall aesthetic: 8K resolution, sharp focus on the screen, realistic textures on the Switch plastic hardware.
- ${layerPrompt}
- ${data.extra}

--ar 16:9 --v 6.0`;

  document.getElementById('output').textContent = prompt;
}

function copyPrompt() {
  const text = document.getElementById('output').textContent;
  if (text.includes('請填寫')) return;
  navigator.clipboard.writeText(text).then(() => alert('✅ 指令已複製！請貼上至 AI 生成器。'));
}

function clearAll() {
  if (confirm('確定要清空嗎？')) location.reload();
}
</script>
</body>
</html>
